# Copy this file to .env and fill in real values. .env is git-ignored.

# MongoDB connection string.
# Local server with a login:  mongodb://USERNAME:PASSWORD@127.0.0.1:27017/?authSource=admin
# MongoDB Atlas:              mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# URL-encode special characters in the password (@ → %40, : → %3A, / → %2F, # → %23).
MONGODB_URI=mongodb://USERNAME:PASSWORD@127.0.0.1:27017/?authSource=admin

# Database the app reads and writes.
MONGODB_DB=robot_monitoring
PORT=3333
